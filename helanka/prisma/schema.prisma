generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
  SPECIALIST
}

enum TripSessionStatus {
  ACTIVE
  IDLE
  QUOTE_REQUESTED
  CLOSED
}

enum ChatMessageType {
  TEXT
  SUGGESTION
  SYSTEM
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  DISMISSED
}

enum BookingStatus {
  DRAFT
  QUOTE_REQUESTED
  PRICING_IN_PROGRESS
  QUOTE_SENT
  REVISION_REQUESTED
  CONFIRMED
  BALANCE_DUE
  COMPLETED
  CANCELLED
  EXPIRED
}

enum BookingItemType {
  ACCOMMODATION
  ACTIVITY
  TRANSPORT
  ADDON
}

enum QuoteResponse {
  ACCEPTED
  REVISION
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerified   DateTime?
  passwordHash    String?
  name            String?
  phone           String?
  country         String?
  image           String?
  role            UserRole  @default(CUSTOMER)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastLogin       DateTime?

  specialty String?

  accounts           Account[]
  sessions           Session[]
  bookings           Booking[]
  reviews            Review[]
  customerTripSessions  TripSession[] @relation("CustomerSessions")
  specialistTripSessions TripSession[] @relation("SpecialistSessions")
  chatMessages       ChatMessage[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Destination {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  region              String
  description         String
  highlights          String[]
  photos              String[]
  distanceFromColomboKm Float?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  packageItems  PackageItem[]
  bookingItems  BookingItem[]
  rateCards     RateCard[]
  excursions    Excursion[]
  hotels        Hotel[]
  distancesFrom DestinationDistance[] @relation("DistanceFrom")
  distancesTo   DestinationDistance[] @relation("DistanceTo")

  @@map("destinations")
}

model Hotel {
  id            String       @id @default(cuid())
  name          String
  destinationId String?
  tier          String
  doubleRate    Float
  validUntil    DateTime
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  destination            Destination?          @relation(fields: [destinationId], references: [id])
  accommodationDetails   AccommodationDetail[]

  @@map("hotels")
}

model DestinationDistance {
  id         String @id @default(cuid())
  fromId     String
  toId       String
  distanceKm Float

  from Destination @relation("DistanceFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   Destination @relation("DistanceTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@map("destination_distances")
}

model Excursion {
  id            String  @id @default(cuid())
  name          String
  slug          String  @unique
  destinationId String
  type          String
  distanceKm    Float
  description   String?
  isActive      Boolean @default(true)

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@map("excursions")
}

model Package {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String
  durationDays Int
  highlights   String[]
  difficulty   String?
  region       String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items PackageItem[]

  @@map("packages")
}

model PackageItem {
  id            String          @id @default(cuid())
  packageId     String
  type          BookingItemType
  destinationId String?
  description   String
  sortOrder     Int

  package     Package      @relation(fields: [packageId], references: [id], onDelete: Cascade)
  destination Destination? @relation(fields: [destinationId], references: [id])

  @@map("package_items")
}

model RateCard {
  id            String   @id @default(cuid())
  itemType      BookingItemType
  destinationId String?
  tier          String?
  season        String
  minPrice      Float
  maxPrice      Float
  perKmRate     Float?
  currency      String   @default("USD")
  updatedAt     DateTime @updatedAt

  destination Destination? @relation(fields: [destinationId], references: [id])

  @@map("rate_cards")
}

model Booking {
  id             String        @id @default(cuid())
  userId         String
  status         BookingStatus @default(DRAFT)
  arrivalDate    DateTime?
  departureDate  DateTime?
  numTravelers   Int           @default(1)
  flightNumber   String?
  sourceChannel  String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  items        BookingItem[]
  quotes       Quote[]
  payments     Payment[]
  reviews      Review[]
  tripSessions TripSession[]

  @@map("bookings")
}

model BookingItem {
  id            String          @id @default(cuid())
  bookingId     String
  type          BookingItemType
  destinationId String?
  description   String
  dates         String?
  nights        Int?
  tier          String?
  estimateMin   Float?
  estimateMax   Float?
  actualPrice   Float?
  notes         String?
  sortOrder     Int             @default(0)

  booking              Booking               @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  destination          Destination?           @relation(fields: [destinationId], references: [id])
  accommodationDetail  AccommodationDetail?
  transportDetail      TransportDetail?
  excursionDetail      ExcursionDetail?
  otherChargeDetail    OtherChargeDetail?

  @@map("booking_items")
}

model Quote {
  id              String         @id @default(cuid())
  bookingId       String
  version         Int
  totalPrice      Float
  deposit         Float
  validUntil      DateTime
  adminNotes      String?
  sentAt          DateTime?
  respondedAt     DateTime?
  response        QuoteResponse?
  taxRate         Float          @default(0)
  taxInclusive    Boolean        @default(true)
  handlingFeeType String?
  handlingFeeAmt  Float          @default(0)
  discountAmt     Float          @default(0)
  lkrExchangeRate Float?
  createdAt       DateTime       @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("quotes")
}

// ── Category detail models ─────────────────────────────────

model AccommodationDetail {
  id               String @id @default(cuid())
  bookingItemId    String @unique
  hotelId          String?
  hotelName        String
  starRating       String?
  roomType         String?
  mealPlan         String?
  sglRooms         Int    @default(0)
  sglRate          Float  @default(0)
  dblRooms         Int    @default(0)
  dblRate          Float  @default(0)
  twnRooms         Int    @default(0)
  twnRate          Float  @default(0)
  tplRooms         Int    @default(0)
  tplRate          Float  @default(0)
  extraAdultQty    Int    @default(0)
  extraAdultRate   Float  @default(0)
  childSharingQty  Int    @default(0)
  childSharingRate Float  @default(0)
  childWithBedQty  Int    @default(0)
  childWithBedRate Float  @default(0)
  marginType       String @default("fixed")
  marginValue      Float  @default(0)
  rateCode         String?
  remarks          String?

  bookingItem BookingItem @relation(fields: [bookingItemId], references: [id], onDelete: Cascade)
  hotel       Hotel?      @relation(fields: [hotelId], references: [id])

  @@map("accommodation_details")
}

model TransportDetail {
  id                  String  @id @default(cuid())
  bookingItemId       String  @unique
  vehicleType         String
  ratePerKm           Float   @default(0)
  vehicleUnits        Int     @default(1)
  distanceKm          Float   @default(0)
  isGroupTransfer     Boolean @default(false)
  pickupLocation      String?
  dropoffLocation     String?
  overridePrice       Boolean @default(false)
  driverGuideType     String?
  driverRatePerDay    Float   @default(0)
  driverAccommodation Boolean @default(false)
  driverFee           Float   @default(0)
  remarks             String?

  bookingItem BookingItem @relation(fields: [bookingItemId], references: [id], onDelete: Cascade)

  @@map("transport_details")
}

model ExcursionDetail {
  id            String  @id @default(cuid())
  bookingItemId String  @unique
  excursionName String
  sequence      Int     @default(0)
  costPerPerson Float   @default(0)
  adultCount    Int     @default(0)
  childRate     Float   @default(0)
  childCount    Int     @default(0)
  overridePrice Boolean @default(false)
  remarks       String?

  bookingItem BookingItem @relation(fields: [bookingItemId], references: [id], onDelete: Cascade)

  @@map("excursion_details")
}

model OtherChargeDetail {
  id            String  @id @default(cuid())
  bookingItemId String  @unique
  costItem      String
  description   String?
  costPerUnit   Float   @default(0)
  units         Int     @default(0)
  overridePrice Boolean @default(false)
  remarks       String?

  bookingItem BookingItem @relation(fields: [bookingItemId], references: [id], onDelete: Cascade)

  @@map("other_charge_details")
}

model Payment {
  id              String        @id @default(cuid())
  bookingId       String
  amount          Float
  currency        String        @default("USD")
  method          String?
  webxpayRef      String?
  status          PaymentStatus @default(PENDING)
  paidAt          DateTime?
  createdAt       DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("payments")
}

model BlogPost {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  content         String
  excerpt         String?
  coverImage      String?
  author          String
  category        String    @default("Travel Tips")
  readTime        String    @default("5 min")
  featured        Boolean   @default(false)
  metaTitle       String?
  metaDescription String?
  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("blog_posts")
}

model Review {
  id          String   @id @default(cuid())
  userId      String
  bookingId   String
  rating      Int
  title       String?
  body        String
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("reviews")
}

model AnalyticsEvent {
  id            String   @id @default(cuid())
  sessionId     String?
  userId        String?
  eventType     String
  eventData     Json?
  sourceChannel String?
  utmParams     Json?
  createdAt     DateTime @default(now())

  @@index([eventType])
  @@index([createdAt])
  @@map("analytics_events")
}

model TripSession {
  id             String            @id @default(cuid())
  customerId     String
  specialistId   String?
  bookingId      String?
  tripType       String
  state          Json
  activeTab      String            @default("overview")
  status         TripSessionStatus @default(ACTIVE)
  lastActivityAt DateTime          @default(now())
  idleSince      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  customer   User     @relation("CustomerSessions", fields: [customerId], references: [id])
  specialist User?    @relation("SpecialistSessions", fields: [specialistId], references: [id])
  booking    Booking? @relation(fields: [bookingId], references: [id])
  messages   ChatMessage[]

  @@index([customerId, status])
  @@index([specialistId, status])
  @@index([status, lastActivityAt])
  @@map("trip_sessions")
}

model ChatMessage {
  id               String            @id @default(cuid())
  sessionId        String
  senderId         String
  senderRole       UserRole
  content          String
  messageType      ChatMessageType   @default(TEXT)
  suggestionData   Json?
  suggestionStatus SuggestionStatus?
  createdAt        DateTime          @default(now())

  session TripSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender  User        @relation(fields: [senderId], references: [id])

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}
